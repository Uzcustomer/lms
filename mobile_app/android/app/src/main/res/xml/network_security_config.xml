<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS only, system CAs only. User-installed CAs are not trusted so a
         proxy certificate on a rooted/managed device cannot intercept traffic. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
