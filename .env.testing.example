# Testlar uchun muhit (nusxa oling: cp .env.testing.example .env.testing).
# Migratsiyalar MySQL'ga xos SQL ishlatadi, shuning uchun testlar SQLite'da emas,
# alohida bo'sh MySQL test bazasida ishlaydi. Bu bazani prod bazasi bilan adashtirmang —
# RefreshDatabase uni har safar tozalaydi.
#
#   CREATE DATABASE lms_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   php artisan test
APP_NAME=LMS
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Tashkent

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lms_test
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
LOG_CHANNEL=stderr
LOG_LEVEL=error
